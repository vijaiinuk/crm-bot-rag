metry x="80" y="44" width="170" height="80" as="geometry"/></mxCell><mxCell id="roles" value="&lt;font color='#666666'&gt;viewer · editor · publisher&lt;br&gt;role from the verified JWT&lt;/font&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;align=center;" vertex="1" parent="g_ops"><mxGeometry x="80" y="136" width="170" height="40" as="geometry"/></mxCell><mxCell id="e_admin" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="g_ops" source="admin" target="admin_app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_svc" value="Chatbot service · FastAPI, stateless" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="780" height="300" as="geometry"/></mxCell><mxCell id="lane" value="POST /chat · query pipeline, streamed over SSE" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="g_svc"><mxGeometry x="16" y="30" width="400" height="22" as="geometry"/></mxCell><mxCell id="s1" value="Verify JWT&lt;br&gt;→ allowed&lt;br&gt;modules" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g_svc"><mxGeometry x="16" y="60" width="84" height="64" as="geometry"/></mxCell><mxCell id="s2" value="Guardrails&lt;br&gt;+ PII&lt;br&gt;redaction" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g_svc"><mxGeometry x="110" y="60" width="84" heigh