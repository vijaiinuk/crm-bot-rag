" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s2_s3" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s3_s4" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s4_s5" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s5_s6" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s6_s7" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s7_s8" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;endSize=4;" edge="1" parent="g_svc" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="refusal" value="Weak match → &lt;b&gt;templated refusal&lt;/b&gt;, no LLM call" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="g_svc"><mxGeometry x="392" y="140" width="250" height="34" as="geometry"/></mxCell><mxCell id="e_refusal" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="g_svc" source="s5" target="refusal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="admin_api" value="&lt;b&gt;/admin/*&lt;/b&gt;&lt;br&gt;upload + validate docs · publish / roll back&lt;br&gt;eval questions · labels · cost reports" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g_svc"><mxGeometry x="16" y="204" width="310" height="76" as="geometry"/></mxCell><mxCell id="perm" value="&lt;b&gt;Permission enforcement&lt;/b&gt;&lt;br&gt;tenant, user, role only from the verified JWT&lt;br&gt;modules resolved server-side · filtered inside SQL · fail closed" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="g_svc"><mxGeometry x="346" y="204" width="418" height="76" as="geometry"/></mxCell><mxCell id="g_wk" value="Worker · same codebase, Postgres job queue" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="780" height="170" as="geometry"/></mxCell><mxCell id="j1" value="&lt;b&gt;build_release&lt;/b&gt;&lt;br&gt;chunk → embed (cache)&lt;br&gt;→ new index version&lt;br&gt;→ gate → repoint live" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g_wk"><mxGeometry x="16" y="44" width="220" height="108" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Publish gate&lt;/b&gt; · no LLM&lt;br&gt;permission suite, zero tolerance&lt;br&gt;retrieval recall vs. live release&lt;br&gt;orphaned eval labels&lt;br&gt;access widening → publisher confirms" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="g_wk"><mxGeometry x="256" y="44" width="260" height="108" as="geometry"/></mxCell><mxCell id="j2" value="&lt;b&gt;generate_synthetic_evals&lt;/b&gt;&lt;br&gt;→ proposed questions&lt;br&gt;&lt;b&gt;run_e2e_eval&lt;/b&gt; (manual)&lt;br&gt;→ LLM judge · admin labels&lt;br&gt;&lt;font color='#666666'&gt;LLM calls go through LiteLLM&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="g_wk"><mxGeometry x="536" y="44" width="228" height="108" as="geometry"/></mxCell><mxCell id="e_j1_gate" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="g_wk" source="j1" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg" value="&lt;b&gt;Postgres 16&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;RDS in production&lt;/font&gt;&lt;br&gt;&lt;br&gt;chunks · pgvector · tsvector&lt;br&gt;documents · versions&lt;br&gt;releases · active_index&lt;br&gt;jobs (queue)&lt;br&gt;conversations · messages&lt;br&gt;llm_calls · model_prices&lt;br&gt;eval_* · audit_log" style="fontFamily=Helvetica;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1f2f0;strokeColor=#0e6b66;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="190" height="280" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LiteLLM&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;provider = config&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="160" height="60" as="geometry"/></mxCell><mxCell id="or" value="&lt;b&gt;OpenRouter&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;dev · bake-off&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="215" width="160" height="50" as="geometry"/></mxCell><mxCell id="bedrock" value="&lt;b&gt;AWS Bedrock&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;production&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="300" width="160" height="50" as="geometry"/></mxCell><mxCell id="models" value="&lt;b&gt;Local models&lt;/b&gt; · bge-m3 embeddings · bge-reranker-v2-m3&lt;br&gt;&lt;font color='#666666'&gt;used by /chat (query embed, rerank) and the worker · MPS locally, CPU/GPU on AWS&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="380" height="60" as="geometry"/></mxCell><mxCell id="phoenix" value="&lt;b&gt;Phoenix&lt;/b&gt; · OpenTelemetry traces from the API and worker, for engineers" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="560" width="380" height="50" as="geometry"/></mxCell><mxCell id="e_w_s1" value="JWT + question" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=1