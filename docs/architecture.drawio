ll=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="llm" target="bedrock"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="150"/><mxPoint x="1600" y="325"/></Array></mxGeometry></mxCell><mxCell id="e_api_pg" value="docs · releases · costs" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.86;" edge="1" parent="1" source="admin_api" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="531" y="420"/><mxPoint x="1165" y="420"/><mxPoint x="1165" y="361"/></Array></mxGeometry></mxCell><mxCell id="e_wk_pg" value="jobs · chunks · results" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.09;entryX=0.2;entryY=1;" edge="1" parent="1" source="g_wk" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1238" y="455"/></Array></mxGeometry></mxCell><mxCell id="e_wk_mod" value="embed" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="g_wk" target="models"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_wk_px" value="spans" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="g_wk" target="phoenix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;font color='#b85450'&gt;&lt;b&gt;red&lt;/b&gt;&lt;/font&gt; = permission enforcement · dashed = telemetry, production-only or fallback path · Postgres is the only datastore" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1100" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Release lifecycle" id="release"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Release lifecycle&lt;/b&gt; · from upload to live" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="36" as="geometry"/></mxCell><mxCell id="t2" value="&lt;font color='#666666'&gt;Each upload is an immutable document version. Chat users see nothing new until a release passes the gate. Rollback re-points active_index.&lt;/font&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1000" height="24" as="geometry"/></mxCell><mxCell id="up" value="&lt;b&gt;Uploaded&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;markdown + frontmatter&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="150" height="64" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;Validated&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="130" height="64" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;In draft release&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="140" height="64" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Building&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;chunk · embed · index&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="150" height="64" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Gate&lt;/b&gt;" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="167" width="120" height="90" as="geometry"/></mxCell><mxCell id="live" value="&lt;b&gt;Live&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;active_index&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="140" height="64" as="geometry"/></mxCell><mxCell id="rej" value="Rejected&lt;br&gt;&lt;font color='#666666'&gt;errors shown at upload&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="230" y="320" width="150" height="56" as="geometry"/></mxCell><mxCell id="fail" value="Failed&lt;br&gt;&lt;font color='#666666'&gt;gate report explains why&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="795" y="320" width="150" height="56" as="geometry"/></mxCell><mxCell id="wait" value="&lt;b&gt;Awaiting confirmation&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;access was widened&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="200" height="56" as="geometry"/></mxCell><mxCell id="sup" value="Superseded&lt;br&gt;&lt;font color='#666666'&gt;kept for rollback&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="320" width="150" height="56" as="geometry"/></mxCell><mxCell id="q1" value="validate" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="up" target="val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2" value="editor adds" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="val" target="draft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q3" value="publish" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="draft" target="build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q4" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="build" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q5" value="pass" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontColor=#4d7a3a;" edge="1" parent="1" source="gate" target="live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q6" value="invalid" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;" edge="1" parent="1" source="val" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q7" value="leak · regression · orphaned label" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="gate" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q8" value="widened" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeColor=#d6b656;" edge="1" parent="1" source="gate" target="wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q9" value="publisher confirms" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wait" target="live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q10" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="live" target="sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q11" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;dashed=1;" edge="1" parent="1" source="sup" target="live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lbl_next" value="next release&lt;br&gt;goes live" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;align=right;" vertex="1" parent="1"><mxGeometry x="940" y="270" width="105" height="34" as="geometry"/></mxCell><mxCell id="lbl_rb" value="rollback" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1116" y="278" width="70" height="20" as="geometry"/></mxCell><mxCell id="checks" value="&lt;b&gt;The publish gate&lt;/b&gt; (automatic, no LLM calls)&lt;br&gt;&lt;br&gt;&lt;font color='#b85450'&gt;&lt;b&gt;Permission suite&lt;/b&gt;&lt;/font&gt; · every persona × every eval question: each retrieved chunk's modules ⊆ allowed. One leak fails.&lt;br&gt;&lt;b&gt;Retrieval evals&lt;/b&gt; · recall@k and complete recall@k must not regress vs. the live release.&lt;br&gt;&lt;b&gt;Orphaned labels&lt;/b&gt; · eval questions pointing at a heading that no longer exists block publishing.&lt;br&gt;&lt;b&gt;Access widening&lt;/b&gt; · a doc's modules changed so more users can see it → a publisher must confirm (audit-logged)." style="fontFamily=Helvetica;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1110" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>