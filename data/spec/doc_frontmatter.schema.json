{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc_frontmatter.schema.json",
  "title": "Doc frontmatter",
  "description": "The contract for every doc, synthetic or real. Structure only: module names are checked against the CRM spec in code, and an unknown module aborts the run (rule 4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_id", "title", "modules", "version"],
  "properties": {
    "doc_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "version": { "type": "integer", "minimum": 1 }
  }
}
