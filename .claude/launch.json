{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "widget",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "widget", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-8001",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CHATBOT_CORS_ORIGINS=[\"http://localhost:5173\"]",
        "CHATBOT_JWKS_URL=http://localhost:8001/.well-known/jwks.json",
        "uv", "run", "uvicorn", "--factory", "chatbot.api.app:create_app", "--port", "8001"
      ],
      "port": 8001
    }
  ]
}
